# ─────────────────────────────────────────────────────────────────────────────
# BlackVanta — Environment Variables
# Copy this file to .env (local dev) and .env.production (GitHub Pages build).
# Never commit either file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# WalletConnect Project ID — get one free at https://cloud.walletconnect.com
# Without this, only injected wallets (MetaMask) will work.
VITE_WALLETCONNECT_PROJECT_ID=YOUR_PROJECT_ID_HERE

# BlackVanta contract address — paste here after deploying
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# USDT BEP20 address (BSC Mainnet — do not change for production)
VITE_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# ─── Chain Selection ──────────────────────────────────────────────────────────
#  31337 → Hardhat local node (RPC: http://127.0.0.1:8545)
#           Start with: npx hardhat node
#           Deploy with: npx hardhat run scripts/deploy.ts --network localhost
#  97    → BSC Testnet  (Explorer: https://testnet.bscscan.com)
#  56    → BSC Mainnet  (Explorer: https://bscscan.com)
VITE_CHAIN_ID=31337

# ─── GitHub Pages Base Path ───────────────────────────────────────────────────
# REQUIRED for GitHub Pages. Set this to /<your-repo-name>/ (with slashes).
# Leave as '/' for local development — it defaults to '/' if unset.
#
# Example: if your repo is https://github.com/alice/blackvanta-app
#   VITE_BASE_URL=/blackvanta-app/
#
# How to use:
#   1. Create a .env.production file (gitignored) with the values below:
#        VITE_BASE_URL=/blackvanta-app/
#        VITE_CHAIN_ID=56
#        VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddress
#        VITE_WALLETCONNECT_PROJECT_ID=your_project_id
#
#   2. Then run: npm run deploy
#      This runs: npm run build  →  gh-pages -d dist
#
# Also update the "homepage" field in package.json:
#   "homepage": "https://alice.github.io/blackvanta-app/"
VITE_BASE_URL=/
